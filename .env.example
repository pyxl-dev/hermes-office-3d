# Hermes Office 3D — configuration example.
# Copy to `.env` (git-ignored) and fill in. NEVER commit a real `.env`.

# --- office server binding --------------------------------------------------
# Loopback only. Binding any other host is refused unless you explicitly set
# HERMES_OFFICE_ALLOW_REMOTE=1 — and you should not, unless something
# authenticated (e.g. Tailscale Serve) sits in front of it.
HERMES_OFFICE_HOST=127.0.0.1
HERMES_OFFICE_PORT=8765
HERMES_OFFICE_ALLOW_REMOTE=0

# Access token that guards EVERY route (UI, API and SSE). If unset, a random
# one is generated at startup and written to ~/.hermes-office-token (mode 0600)
# — it is never printed. Treat it like a password.
HERMES_OFFICE_TOKEN=

# --- upstream Hermes API (read-only, server-side only) ----------------------
# The browser never talks to this address; only this server does.
HERMES_API_BASE=http://127.0.0.1:8642
# The gateway API key (API_SERVER_KEY). Leave empty to run in DEMO mode with
# synthetic fixtures and no secrets. Never commit the real value.
HERMES_API_KEY=

# --- tuning -----------------------------------------------------------------
HERMES_OFFICE_POLL_SECONDS=4
HERMES_OFFICE_ACTIVE_SECONDS=120
HERMES_OFFICE_IDLE_SECONDS=300
HERMES_OFFICE_MAX_ACTORS=48
